{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameForge",
  "version": "1.0.0",
  "identifier": "app.frameforge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FrameForge",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "FrameForge",
    "copyright": "© 2026 FrameForge",
    "category": "Utility",
    "shortDescription": "Find the best graphics settings for your PC, offline.",
    "longDescription": "FrameForge tests a few graphics settings on your own PC and finds the combination that runs smoother while still looking great. Everything runs on your computer. No account, no internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/adapters/*",
      "resources/tools/*",
      "resources/engine/**/*"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
